{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Locken",
  "version": "2.0.8",
  "identifier": "app.locken.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Locken",
        "width": 1040,
        "height": 700,
        "minWidth": 640,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://isohdbjcvluvaflmrfeg.supabase.co https://api.pwnedpasswords.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Locken",
    "copyright": "\u00a9 2026 Locken",
    "category": "Productivity",
    "shortDescription": "Focus app for students",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "locken"
        ]
      }
    }
  }
}
