#!/bin/bash
# Blocks a commit that adds a secret: API keys, private keys, a Supabase service-role key, or a .env file.
# The public Supabase anon key is allowed. Bypass only for a false positive: git commit --no-verify
set -uo pipefail

fail=0
report() { echo "pre-commit: $1" >&2; fail=1; }

# .env files (examples are fine).
while IFS= read -r file; do
  case "$file" in
    *.env.example|*.env.sample) ;;
    .env|*/.env|.env.*|*/.env.*) report "refusing to commit $file (environment files hold secrets)";;
  esac
done < <(git diff --cached --name-only --diff-filter=AM)

# Only lines this commit adds.
added="$(git diff --cached -U0 --diff-filter=AM | grep -E '^\+[^+]' || true)"

check() {  # pattern, description
  if printf '%s\n' "$added" | grep -Eq -- "$1"; then report "looks like $2 was added"; fi
}
check 'sk-ant-(api|admin)[0-9]{2}-[A-Za-z0-9_-]{20,}' "an Anthropic API key"
check 'AIza[0-9A-Za-z_-]{35}' "a Google API key"
check 'sk-(proj-)?[A-Za-z0-9]{32,}' "an OpenAI key"
check 'xai-[A-Za-z0-9]{40,}' "an xAI key"
check 'sk_live_[0-9A-Za-z]{20,}' "a Stripe live key"
check '(ghp|gho|ghu|ghs)_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,}' "a GitHub token"
check 'AKIA[0-9A-Z]{16}' "an AWS access key"
check 'xox[abpr]-[A-Za-z0-9-]{10,}' "a Slack token"
check '-----BEGIN ([A-Z]+ )?PRIVATE KEY-----' "a private key"
check 'SUPABASE_SERVICE_ROLE_KEY *= *[A-Za-z0-9._-]{20,}' "a Supabase service-role key"
check 'sb_secret_[A-Za-z0-9_-]{20,}' "a Supabase secret key"

# Any JWT whose payload says service_role (the anon key's says anon, which is fine).
for jwt in $(printf '%s\n' "$added" | grep -Eo 'eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}' | sort -u); do
  payload="$(printf '%s' "$jwt" | cut -d. -f2 | tr '_-' '/+')"
  while [ $(( ${#payload} % 4 )) -ne 0 ]; do payload="$payload="; done
  if printf '%s' "$payload" | base64 -D 2>/dev/null | grep -q '"service_role"'; then
    report "a Supabase service-role JWT was added"
  fi
done

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: commit blocked. Move the secret to the Keychain or server env (see docs/SECURITY.md)." >&2
  exit 1
fi
exit 0
