<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime: Locken sends Apple Events to read the playing song, the front browser tab and Apple Notes,
	     and to close blocked tabs during a session (see NSAppleEventsUsageDescription in Info.plist). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- The Assistant tab listens while it's open: speech is turned into text on the Mac. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
